# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use for speech-to-text. Both are on Groq's free tier.
# whisper-large-v3        -> most accurate
# whisper-large-v3-turbo  -> faster, slightly less accurate
GROQ_MODEL=whisper-large-v3

# Text model used to convert captions into Hinglish / Hindi / Urdu / Kannada / Malayalam, or into sound-based English letters (auto)
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Paths to FFmpeg and FFprobe. Leave both empty to use the ones found on your PATH.
# Set them only if FFmpeg is installed somewhere that is not on your PATH.
# Windows: use forward slashes and no quotes (quotes turn \f and \b into control characters)
#   FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
#   FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
# macOS / Linux:
#   FFMPEG_PATH=/usr/local/bin/ffmpeg
#   FFPROBE_PATH=/usr/local/bin/ffprobe
FFMPEG_PATH=
FFPROBE_PATH=

# Default answers for the two language prompts (press Enter to accept them)
# SOURCE_LANG (what is spoken): auto, en, hi, ur, kn, ml
# TARGET_LANG (what the .srt contains): en, hi, ur, kn, ml, hing, auto
# auto as TARGET_LANG = sound-to-sound: every word is written in English letters exactly as it sounds, with no translation
# It uses a local phoneme model (about 1.3 GB), downloaded once into the hidden models folder. Needs: pip install -r requirements-auto.txt
SOURCE_LANG=auto
TARGET_LANG=en
# PHONEME_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
# PHONEME_MODEL_PATH=C:/path/to/an/existing/phoneme/model/folder
# CUSTOM_PROMPT="This audio contains a mix of Hindi, Malayalam and Kannada languages"
CUSTOM_PROMPT=